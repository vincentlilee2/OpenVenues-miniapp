/* 「活动」tab 页（2026-09-26）—— 活动与课程共用一张卡的样式，课程多一行芯片（教练/课时） */
.hero {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  padding: 40rpx 32rpx 50rpx;
  margin: 0 -24rpx 20rpx;
  color: #fff;
}
.hero-title { font-size: 40rpx; font-weight: 600; margin-bottom: 8rpx; }
.hero-sub { font-size: 26rpx; opacity: 0.85; }

/* 段选：活动 / 课程 */
.seg {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.seg-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: var(--muted);
  background: rgba(58, 125, 68, 0.08);
  border-radius: 999rpx;
}
.seg-item.on {
  color: #fff;
  background: var(--primary);
  font-weight: 600;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.06);
}

.card-cover { position: relative; width: 100%; height: 360rpx; }
.cover-img { width: 100%; height: 100%; }
.cover-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, var(--primary-light), var(--primary));
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
}
.cp-line1 { font-size: 52rpx; font-weight: 700; text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.2); }
.cp-line2 { font-size: 26rpx; margin-top: 8rpx; opacity: 0.9; }

.tag {
  position: absolute;
  top: 20rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
}
.tag.expired { left: 20rpx; background: rgba(0,0,0,0.6); color: #fff; }
.tag.recurrence {
  top: 60rpx;              /* 排在价格/已截止下面，避免互相压住 */
  left: 20rpx;
  background: rgba(14, 165, 233, 0.92);
  color: #fff;
  font-size: 22rpx;
}
.tag.price {
  right: 20rpx;
  background: var(--gold);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}
.tag.price .per { font-size: 20rpx; font-weight: 400; opacity: 0.9; }

.card-body { padding: 24rpx 28rpx 28rpx; }
.card-title { font-size: 32rpx; font-weight: 600; margin-bottom: 12rpx; }

.chips { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 12rpx; }
.chip {
  font-size: 22rpx;
  color: var(--primary);
  background: rgba(58, 125, 68, 0.10);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

.meta { display: flex; gap: 20rpx; font-size: 24rpx; margin-bottom: 8rpx; }
.meta-people { color: var(--primary); font-weight: 500; }
.meta-sub { color: #b45309; }
.loc, .when { font-size: 24rpx; color: var(--muted); margin-top: 4rpx; }

.empty { text-align: center; color: var(--muted); padding: 80rpx 0; }
