<view class="container">
  <!-- 顶部品牌区（2026-09-24：首页不放"转发"按钮 —— 会破坏这一行的排版；
       首页的转发走右上角「…」菜单，靠 index.js 里的 onShareAppMessage/onShareTimeline 生效） -->
  <view class="brand">
    <view class="brand-name">🎾 OpenVenues</view>
    <view class="city">📍 全部场馆 ▾</view>
  </view>

  <!-- 横幅：点击进入畅打活动列表 -->
  <view class="banner" bindtap="openPromos">
    <view class="banner-main">
      <view class="banner-title">在线预约 · 畅打活动</view>
      <view class="banner-sub">{{promoSubText}}</view>
    </view>
    <view class="banner-cta">
      <text class="banner-cta-text">活动列表</text>
      <text class="banner-arrow">›</text>
    </view>
  </view>

  <!-- 加载/空 -->
  <view wx:if="{{loading}}" class="empty">加载中...</view>
  <view wx:elif="{{loadError}}" class="empty">
    <view>{{loadError}}</view>
    <view style="margin-top:16rpx;color:var(--primary);text-decoration:underline" bindtap="retryLoad">点此重试</view>
  </view>
  <view wx:elif="{{venues.length === 0}}" class="empty">暂无场馆</view>

  <!-- 场馆卡片列表（参考截图：场馆 = 一卡，含若干场地） -->
  <view wx:for="{{venues}}" wx:key="id" class="venue-card" bindtap="openDetail" data-id="{{item.id}}">
    <view class="venue-cover-wrap">
      <image wx:if="{{item.cover}}" class="venue-cover" src="{{item.cover}}" mode="aspectFill"></image>
      <image wx:elif="{{item.defaultCover}}" class="venue-cover" src="{{item.defaultCover}}" mode="aspectFill"></image>
      <view wx:else class="venue-cover venue-cover--placeholder">
        <text class="placeholder-text">{{item.name}}</text>
      </view>
      <!-- ♡ 收藏：留在 .venue-cover-wrap 内部（它才是 position:relative 基准）。
           移出会导致 absolute 相对整页定位、按钮飘到页面顶部（2026-09-23 实测事故）。 -->
      <view class="venue-fav" catchtap="toggleFav" data-id="{{item.id}}">♡</view>
    </view>
    <view class="venue-body">
      <view class="venue-name">{{item.name}}
        <text class="venue-court-count">{{item.court_count}} 场地</text>
      </view>
      <!-- 导航按钮：跟在地址后面（同一行右侧），不再压在封面图上 -->
      <view class="venue-addr">
        <view class="venue-addr-text">📍 {{item.address || '地址待补充'}}</view>
        <view class="venue-nav" catchtap="openMap" data-id="{{item.id}}">⊕ 导航</view>
      </view>
      <!-- 场地缩略标签 -->
      <view class="venue-courts" wx:if="{{item.courts && item.courts.length}}">
        <text wx:for="{{item.courts}}" wx:key="id" wx:for-item="c" class="court-chip">{{c.name}}</text>
      </view>
    </view>
  </view>
</view>