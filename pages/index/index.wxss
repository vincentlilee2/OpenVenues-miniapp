.brand {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 4rpx 20rpx;
}
.brand-name {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--primary-dark);
}
.city {
  font-size: 26rpx;
  color: var(--muted);
  background: rgba(58, 125, 68, 0.08);
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
}

.banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: #fff;
  padding: 36rpx 32rpx;
  border-radius: 20rpx;
  margin-bottom: 28rpx;
}
.banner:active {
  opacity: 0.9;
}
.banner-main { flex: 1; min-width: 0; }
.banner-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.banner-sub {
  font-size: 24rpx;
  opacity: 0.85;
}
.banner-cta {
  display: flex;
  align-items: center;
  margin-left: 16rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  flex-shrink: 0;
}
.banner-cta-text { font-size: 24rpx; color: #fff; }
.banner-arrow { font-size: 32rpx; color: #fff; margin-left: 6rpx; line-height: 1; }

.venue-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.06);
}

.venue-cover-wrap {
  position: relative;
  width: 100%;
  height: 380rpx;
  background: #e5e7eb;
}
.venue-cover {
  width: 100%;
  height: 100%;
  background-size: cover;
  background-position: center;
}
.venue-cover--placeholder {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  display: flex;
  align-items: center;
  justify-content: center;
}
.placeholder-text {
  color: #fff;
  font-size: 60rpx;
  font-weight: 600;
  opacity: 0.6;
}

/* ♡ 收藏：封面图左上角的浮层。
   定位基准是同级的 .venue-cover-wrap（position: relative）——
   必须写在 venue-cover-wrap 内部，否则会相对整页定位跑到页面顶部。 */
.venue-fav {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.35);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.venue-body {
  padding: 24rpx 28rpx 28rpx;
}
.venue-name {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 6rpx;
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}
.venue-court-count {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--primary);
  background: rgba(58, 125, 68, 0.1);
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
}
/* 地址行：地址文字 + 右侧「⊕ 导航」按钮 */
.venue-addr {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 26rpx;
  color: var(--muted);
  margin-bottom: 12rpx;
}
.venue-addr-text {
  /* 占满剩余宽度 → 导航按钮被推到行末右对齐。
     flex:1 + min-width:0 是让 text-overflow:ellipsis 生效的关键；
     white-space:nowrap 保证绝不折行。 */
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
/* 导航按钮：跟在地址后面（行内胶囊），右对齐且位置恒定——
   flex-shrink:0 + white-space:nowrap 保证地址再长也不会挤动/挤压它 */
.venue-nav {
  flex-shrink: 0;
  white-space: nowrap;
  background: var(--primary);
  color: #fff;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1.4;
}
.venue-courts {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}
.court-chip {
  font-size: 22rpx;
  color: var(--text);
  background: #f3f4f6;
  padding: 4rpx 14rpx;
  border-radius: 14rpx;
}

.empty {
  text-align: center;
  color: var(--muted);
  padding: 80rpx 0;
}

.container { padding-bottom: 140rpx; }
