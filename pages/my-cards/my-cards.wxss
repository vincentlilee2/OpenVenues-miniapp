/* 我的会员卡（2026-09-26）—— 卡面样式在 app.wxss 的 .mcard */
.card-wrap { margin-bottom: 34rpx; }

.card-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 10rpx 0;
}
.bar-sub { font-size: 24rpx; color: var(--muted); flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.bar-btn { flex: none; font-size: 26rpx; color: var(--primary); padding: 6rpx 4rpx 6rpx 20rpx; }

.go-buy { margin-top: 30rpx; width: 320rpx; }
