/* 办卡充值（2026-09-26）—— 卡面样式统一在 app.wxss 的 .mcard */
.hero {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  padding: 40rpx 32rpx 50rpx;
  margin: 0 -24rpx 28rpx;
  color: #fff;
}
.hero-title { font-size: 40rpx; font-weight: 600; margin-bottom: 8rpx; }
.hero-sub { font-size: 26rpx; opacity: 0.85; }

.card-wrap { margin-bottom: 34rpx; }
.card-note { font-size: 24rpx; color: var(--muted); margin-top: 12rpx; padding-left: 8rpx; }

.my-entry {
  margin: 10rpx 0 40rpx;
  padding: 28rpx 24rpx;
  background: #fff;
  border-radius: 20rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--primary);
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.06);
}
