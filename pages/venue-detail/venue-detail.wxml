<view class="container">
  <view wx:if="{{loading}}" class="empty">加载中...</view>
  <block wx:elif="{{venue}}">
    <!-- 海报 -->
    <view class="cover">
      <image wx:if="{{venue.cover}}" class="cover-img" src="{{venue.cover}}" mode="aspectFill"></image>
      <image wx:elif="{{venue.defaultCover}}" class="cover-img" src="{{venue.defaultCover}}" mode="aspectFill"></image>
      <view wx:else class="cover-placeholder">
        <text>{{venue.name}}</text>
      </view>
    </view>

    <!-- 场馆信息 -->
    <view class="card">
      <!-- 名字行：右侧放「分享」+「⊕ 导航」（2026-09-24/25 用户要求；不压海报照片、也不占底部按钮位）。
           名字过长时**省略号截断**，绝不把右侧按钮挤走（与"地址过长不挤走导航按钮"同一原则）。 -->
      <view class="name-row">
        <view class="venue-name">{{venue.name}}</view>
        <button class="share-link" open-type="share" hover-class="share-link-hover">分享</button>
        <view class="nav-link" hover-class="nav-link-hover" bindtap="openMap">⊕ 导航</view>
      </view>
      <view class="row"><text class="label">📍 地址</text><text>{{venue.address || '地址待补充'}}</text></view>
      <view class="row" wx:if="{{venue.contact_phone}}">
        <text class="label">📞 电话</text>
        <text bindtap="callPhone">{{venue.contact_phone}}</text>
      </view>
      <view class="row" wx:if="{{venue.description}}">
        <text class="label">📝 说明</text>
        <text>{{venue.description}}</text>
      </view>
      <view class="row">
        <text class="label">📋 场地</text>
        <text>{{venue.court_count}} 个（每个独立预约）</text>
      </view>
    </view>

    <!-- 场地列表 -->
    <view class="card">
      <view class="title">本馆场地</view>
      <view class="court-list">
        <view wx:for="{{venue.courts}}" wx:key="id" class="court-item">
          <view class="court-name">{{item.name}}</view>
          <!-- 容量是选填项：后台留空（NULL）时这里整行不显示 -->
          <view class="court-cap" wx:if="{{item.max_capacity > 0}}">容纳 {{item.max_capacity}} 人</view>
          <view class="court-status {{item.status === 'active' ? 'on' : 'off'}}">
            {{item.status === 'active' ? '营业中' : '已停用'}}
          </view>
        </view>
      </view>
    </view>

    <!-- 操作按钮（参考截图：约课/约场/畅打）——转发按钮已挪到海报右上角小图标（2026-09-24） -->
    <view class="actions">
      <button class="btn-warn" hover-class="btn-hover" bindtap="onBookLesson">约课</button>
      <button class="btn-outline btn-action" hover-class="btn-hover" bindtap="onBookVenue">约场</button>
      <button class="btn-primary btn-action" hover-class="btn-hover" bindtap="onPromoList">畅打</button>
    </view>
  </block>
</view>