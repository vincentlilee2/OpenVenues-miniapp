/* 场馆详情 */
.cover {
  width: 100%;
  height: 360rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  background: #e5e7eb;
  position: relative; /* 转发小图标要相对海报定位（2026-09-24） */
}
/* 转发入口（海报右上角，2026-09-24）：白色磨砂胶囊「分享」。
   为什么不用半透明黑圆 + ↗：深色封面照片上会糊成一块黑斑，且箭头有歧义（像外链/返回）。
   白底 + 文字在深浅照片上都清晰，也是中文 App 的通用做法。 */
.share-pill {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  padding: 8rpx 22rpx;
  margin: 0;
  font-size: 22rpx;
  line-height: 1.5;
  color: #1f2937;
  background: rgba(255, 255, 255, 0.94);
  border-radius: 999rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.16);
  border: none;
  backdrop-filter: blur(4rpx);
}
.share-pill::after { border: none; } /* 去掉 button 默认边框 */
.share-pill-hover { background: #fff; box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2); }
.cover-img {
  width: 100%;
  height: 100%;
  display: block;
}
.cover-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 48rpx;
  font-weight: 600;
}

.venue-name {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 16rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}
.row .label { color: var(--muted); }
.row:last-child { border-bottom: none; }

.title { font-size: 32rpx; font-weight: 600; margin-bottom: 14rpx; }
.court-list { display: flex; flex-direction: column; gap: 12rpx; }
.court-item {
  display: flex;
  align-items: center;
  padding: 16rpx;
  background: #f9fafb;
  border-radius: 12rpx;
  gap: 12rpx;
}
.court-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text);
  flex: 1;
}
.court-cap {
  font-size: 24rpx;
  color: var(--muted);
}
.court-status {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}
.court-status.on { background: #d1fae5; color: #065f46; }
.court-status.off { background: #fee2e2; color: #991b1b; }

.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
  margin-bottom: 40rpx;
}
.actions button { flex: 1; margin: 0; height: 88rpx; line-height: 88rpx; padding: 0; }
.btn-action { font-size: 30rpx; }

.empty { text-align: center; color: var(--muted); padding: 80rpx 0; }