/* 场馆详情 */
.cover {
  width: 100%;
  height: 360rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  background: #e5e7eb;
}
.cover-img {
  width: 100%;
  height: 100%;
  background-size: cover;
  background-position: center;
}
.cover-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 48rpx;
  font-weight: 600;
}

.venue-name {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 16rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}
.row .label { color: var(--muted); }
.row:last-child { border-bottom: none; }

.title { font-size: 32rpx; font-weight: 600; margin-bottom: 14rpx; }
.court-list { display: flex; flex-direction: column; gap: 12rpx; }
.court-item {
  display: flex;
  align-items: center;
  padding: 16rpx;
  background: #f9fafb;
  border-radius: 12rpx;
  gap: 12rpx;
}
.court-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text);
  flex: 1;
}
.court-cap {
  font-size: 24rpx;
  color: var(--muted);
}
.court-status {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}
.court-status.on { background: #d1fae5; color: #065f46; }
.court-status.off { background: #fee2e2; color: #991b1b; }

.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
  margin-bottom: 40rpx;
}
.actions button { flex: 1; margin: 0; height: 88rpx; line-height: 88rpx; padding: 0; }
.btn-action { font-size: 30rpx; }

.empty { text-align: center; color: var(--muted); padding: 80rpx 0; }