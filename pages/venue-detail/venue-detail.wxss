/* 场馆详情 */
.cover {
  width: 100%;
  height: 360rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  background: #e5e7eb;
}
.cover-img {
  width: 100%;
  height: 100%;
  display: block;
}
.cover-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 48rpx;
  font-weight: 600;
}

.venue-name {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text);
  /* 名字与「分享」同一行：给名字让出弹性空间并允许省略号，
     保证分享按钮位置固定（与"地址过长不挤走导航按钮"同一原则） */
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
/* 名字行（2026-09-24）：场馆名左、分享右 */
.name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
/* 「分享」入口：轻量文字按钮，右对齐、不抢视线（转发能力本身也一直在右上角「…」菜单里） */
.share-link {
  flex: none;
  font-size: 24rpx;
  line-height: 1.4;
  color: var(--muted);
  background: transparent;
  border: none;
  padding: 6rpx 0 6rpx 16rpx;
  margin: 0;
}
.share-link::after { border: none; } /* 去掉 button 默认边框 */
.share-link-hover { opacity: 0.55; }

/* 「⊕ 导航」：与首页场馆卡上的导航按钮**同一套视觉**（主色胶囊），摆在「分享」右侧。
   用户 2026-09-25 要求「在分享按钮右侧也添加对应的导航按钮」——
   "对应"即指与首页卡片那个是同一件事，故样式对齐 index.wxss 的 .venue-nav。 */
.nav-link {
  flex: none;
  white-space: nowrap;
  background: var(--primary);
  color: #fff;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1.4;
}
.nav-link-hover { opacity: 0.7; }

.row {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}
.row .label { color: var(--muted); }
.row:last-child { border-bottom: none; }

.title { font-size: 32rpx; font-weight: 600; margin-bottom: 14rpx; }
.court-list { display: flex; flex-direction: column; gap: 12rpx; }
.court-item {
  display: flex;
  align-items: center;
  padding: 16rpx;
  background: #f9fafb;
  border-radius: 12rpx;
  gap: 12rpx;
}
.court-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text);
  flex: 1;
}
.court-cap {
  font-size: 24rpx;
  color: var(--muted);
}
.court-status {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}
.court-status.on { background: #d1fae5; color: #065f46; }
.court-status.off { background: #fee2e2; color: #991b1b; }

.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
  margin-bottom: 40rpx;
}
.actions button { flex: 1; margin: 0; height: 88rpx; line-height: 88rpx; padding: 0; }
.btn-action { font-size: 30rpx; }

.empty { text-align: center; color: var(--muted); padding: 80rpx 0; }