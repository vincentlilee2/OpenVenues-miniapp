/* 场馆详情 */
.cover {
  width: 100%;
  height: 360rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  background: #e5e7eb;
}
.cover-img {
  width: 100%;
  height: 100%;
  display: block;
}
.cover-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 48rpx;
  font-weight: 600;
}

.venue-name {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text);
  /* 名字与「分享」同一行：给名字让出弹性空间并允许省略号，
     保证分享按钮位置固定（与"地址过长不挤走导航按钮"同一原则） */
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
/* 名字行（2026-09-24）：场馆名左、分享右 */
.name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
/* 「分享」入口已按用户要求去掉（2026-09-25）—— 转发改走右上角「…」菜单，
   所以这里不再保留 .share-link / .share-link-hover 规则（死样式一并删掉）。 */

/* 「⊕ 导航」：与首页场馆卡上的导航按钮**同一套视觉**（主色胶囊）。
   2026-09-25：分享按钮去掉 → 这一行只剩「名称 + 导航」；
   2026-09-26：导航**挪到「地址」行的右侧**（用户要求），名字行右侧改成「介绍…」。 */
.nav-link {
  flex: none;
  white-space: nowrap;
  background: var(--primary);
  color: #fff;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1.4;
}
.nav-link-hover { opacity: 0.7; }

/* 「介绍…」（2026-09-26）：名字行右侧 → 该场馆的介绍文章列表（纯文章，无报名） */
.intro-link {
  flex: none;
  white-space: nowrap;
  background: var(--primary);
  color: #fff;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1.4;
}

.row {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}
.row .label { color: var(--muted); }
.row:last-child { border-bottom: none; }

/* 地址行（2026-09-26）：左标签 + **完整可折行**的地址 + 右侧导航按钮。
   ⚠️ 地址**不能**用省略号截断（用户明确要求「地址信息要显示全，可以折行显示」），
   所以这里给地址 flex:1 + min-width:0 + 允许换行（默认就换行，别设 nowrap/ellipsis）。 */
.row-addr {
  align-items: flex-start;
  gap: 12rpx;
}
.row-addr .label { flex: none; }
.addr-text {
  flex: 1;
  min-width: 0;
  text-align: left;
  word-break: break-word;
  line-height: 1.5;
}
/* 地址行的导航按钮要跟第一行文字对齐 */
.row-addr .nav-link { margin-top: -2rpx; }

.title { font-size: 32rpx; font-weight: 600; margin-bottom: 14rpx; }
.court-list { display: flex; flex-direction: column; gap: 12rpx; }
.court-item {
  display: flex;
  align-items: center;
  padding: 16rpx;
  background: #f9fafb;
  border-radius: 12rpx;
  gap: 12rpx;
}
.court-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text);
  flex: 1;
}
.court-cap {
  font-size: 24rpx;
  color: var(--muted);
}
.court-status {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}
.court-status.on { background: #d1fae5; color: #065f46; }
.court-status.off { background: #fee2e2; color: #991b1b; }

.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
  margin-bottom: 40rpx;
}
.actions button { flex: 1; margin: 0; height: 88rpx; line-height: 88rpx; padding: 0; }
.btn-action { font-size: 30rpx; }

.empty { text-align: center; color: var(--muted); padding: 80rpx 0; }