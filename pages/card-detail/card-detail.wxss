/* 会员卡详情（2026-09-26）—— 卡面样式在 app.wxss 的 .mcard */
.detail-card { margin-bottom: 28rpx; }

.info-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 6rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.06);
}
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--border);
  font-size: 26rpx;
}
.info-row:last-child { border-bottom: none; }
.info-row .k { color: var(--muted); flex: none; }
.info-row .v { color: var(--text); text-align: right; }

.block-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.06);
}
.block-title { font-size: 28rpx; font-weight: 600; margin-bottom: 14rpx; }
.block-text { font-size: 26rpx; color: var(--text); line-height: 1.75; white-space: pre-wrap; }

.actions { margin: 34rpx 0 40rpx; }
.link { text-align: center; color: var(--primary); font-size: 26rpx; padding: 26rpx 0 0; }
