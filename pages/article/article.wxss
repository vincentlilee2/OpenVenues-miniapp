/* 文章详情（服务介绍，2026-09-26）—— 纯展示页 */
.hero {
  position: relative;
  height: 420rpx;
  margin: 0 -24rpx 28rpx;
  overflow: hidden;
}
.hero-img { width: 100%; height: 100%; }
.hero-ph { width: 100%; height: 100%; background: linear-gradient(135deg, var(--primary), var(--primary-light)); }
/* 半透明遮罩：保证标题在任何封面图上都读得清（用户提供的照片深浅不一） */
.hero-mask {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  height: 70%;
  background: linear-gradient(to bottom, rgba(0,0,0,0), rgba(0,0,0,0.55));
}
.hero-text { position: absolute; left: 32rpx; right: 32rpx; bottom: 28rpx; color: #fff; }
.hero-title { font-size: 42rpx; font-weight: 700; line-height: 1.35; text-shadow: 0 2rpx 8rpx rgba(0,0,0,.35); }
.hero-sub { font-size: 26rpx; opacity: .92; margin-top: 10rpx; }

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx 36rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.06);
}
.meta {
  display: flex;
  gap: 24rpx;
  font-size: 24rpx;
  color: var(--muted);
  padding-bottom: 20rpx;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(0,0,0,0.06);
}
.meta-venue { color: var(--primary); }

/* 正文段落：行高放宽，长文可读性优先 */
.para {
  font-size: 30rpx;
  line-height: 1.85;
  color: #333;
  margin-bottom: 24rpx;
  white-space: pre-wrap;
  word-break: break-word;
}
.empty { text-align: center; color: var(--muted); padding: 80rpx 0; }
