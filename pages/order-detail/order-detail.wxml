<view class="container">
  <view wx:if="{{loading}}" class="empty">加载中...</view>
  <block wx:elif="{{order}}">
    <view class="status-card">
      <view class="status-text">{{statusText}}</view>
      <view class="status-no">订单号 {{order.order_no}}</view>
    </view>

    <view class="card">
      <view class="row"><text class="label">场馆</text><text>{{order.venue_name}}</text></view>
      <view class="row"><text class="label">场地</text><text>{{courtText}}</text></view>
      <view class="row"><text class="label">地址</text><text>{{order.venue_address || '地址待补充'}}</text></view>
      <view class="row"><text class="label">日期</text><text>{{order.booking_date}}</text></view>
      <view class="row"><text class="label">时段</text><text>{{order.start_time}} - {{order.end_time}}</text></view>
      <view class="row"><text class="label">时长</text><text>{{durationText}}</text></view>
      <!-- 来源（2026-09-26 用户要求）：不再显示「畅打活动：」前缀，直接显示服务名称 -->
      <view class="row" wx:if="{{order.source === 'promo'}}"><text class="label">来源</text><text>🎯 {{promoTitle}}</text></view>
      <view class="row" wx:else><text class="label">来源</text><text>⏰ 散客预约</text></view>
    </view>

    <view class="card">
      <view class="row"><text class="label">联系人</text><text>{{order.contact_name}}</text></view>
      <view class="row"><text class="label">电话</text><text>{{order.contact_phone}}</text></view>
      <view class="row" wx:if="{{order.remark}}"><text class="label">备注</text><text>{{order.remark}}</text></view>
    </view>

    <view class="card">
      <view class="row big"><text>合计</text><text class="amount">¥{{order.total_price}}</text></view>
      <!-- 支付（2026-09-24） -->
      <view class="row" wx:if="{{needPay}}">
        <text class="label">支付</text>
        <text class="pay-todo">待支付 {{remainText}}</text>
      </view>
      <view class="row" wx:elif="{{payText}}">
        <text class="label">支付</text>
        <text class="pay-ok">{{payText}}</text>
      </view>
      <view class="row" wx:if="{{needPay}}">
        <text class="label"></text>
        <text class="pay-note">请在 15 分钟内完成支付，超时订单自动关闭并释放场地</text>
      </view>
    </view>

    <view class="actions" wx:if="{{needPay}}">
      <button class="btn-primary" bindtap="onPay">去支付 ¥{{order.total_price}}</button>
    </view>
    <view class="actions" wx:if="{{canCancel}}">
      <button class="btn-outline danger" bindtap="onCancel">取消订单</button>
    </view>
    <!-- 不可取消时说明原因（按场馆配置的取消规则） -->
    <view class="cancel-hint" wx:elif="{{cancelHint}}">{{cancelHint}}</view>
  </block>
</view>
