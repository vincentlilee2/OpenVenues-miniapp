.status-tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 12rpx 8rpx;
  margin-bottom: 20rpx;
  overflow-x: auto;
  white-space: nowrap;
}
.st-tab {
  padding: 14rpx 26rpx;
  font-size: 26rpx;
  color: var(--muted);
  border-radius: 10rpx;
}
.st-tab.active {
  background: var(--primary);
  color: #fff;
  font-weight: 500;
}

.order-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  transition: opacity 0.2s, filter 0.2s;
}

/* 已取消 / 已退款：整体变灰 */
.order-card.status-cancelled,
.order-card.status-refunded {
  background: #f5f5f5;
  opacity: 0.55;
}
.order-card.status-cancelled .venue-name,
.order-card.status-refunded .venue-name,
.order-card.status-cancelled .order-time,
.order-card.status-refunded .order-time,
.order-card.status-cancelled .order-source,
.order-card.status-refunded .order-source {
  color: #9ca3af;
  text-decoration: line-through;
}
.order-card.status-cancelled .amount,
.order-card.status-refunded .amount {
  color: #9ca3af !important;
  text-decoration: line-through;
}

/* 已完成：稍灰但保留信息可读 */
.order-card.status-completed {
  background: #fafafa;
  opacity: 0.85;
}
.order-card.status-completed .amount {
  color: #9ca3af;
}

/* 畅打未成团退款：和 cancelled 同款 */
.order-card.status-no_show {
  background: #f5f5f5;
  opacity: 0.55;
}
.order-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f3f4f6;
}
.order-no { font-size: 24rpx; color: var(--muted); font-family: monospace; }
.order-body { padding: 18rpx 0; }
.venue-name { font-size: 30rpx; font-weight: 600; margin-bottom: 8rpx; }
.court-name { font-size: 26rpx; font-weight: 400; color: var(--muted); }
.order-time { font-size: 26rpx; color: var(--text); margin-bottom: 6rpx; }
.order-duration { font-size: 24rpx; color: var(--muted); }
.order-source { font-size: 24rpx; color: var(--primary); }
.order-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 12rpx;
  border-top: 1rpx solid #f3f4f6;
}
.amount { font-size: 34rpx; font-weight: 700; color: #b45309; }
.cancel-link { font-size: 26rpx; color: var(--danger); }
.cancel-hint { font-size: 22rpx; color: var(--muted); margin-left: 12rpx; }

.empty { text-align: center; color: var(--muted); padding: 80rpx 0; }

.container { padding-bottom: 140rpx; }
