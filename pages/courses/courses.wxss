/* 培训课程列表（2026-09-25）——视觉与「活动列表」同一套语言，只把课程专属信息（教练/课时）做成芯片行 */
.hero {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  padding: 40rpx 32rpx 50rpx;
  margin: 0 -24rpx 28rpx;
  color: #fff;
}
.hero-title { font-size: 40rpx; font-weight: 600; margin-bottom: 8rpx; }
.hero-sub { font-size: 26rpx; opacity: 0.85; }

.course-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.06);
}

.course-cover {
  position: relative;
  width: 100%;
  height: 360rpx;
}
.cover-img { width: 100%; height: 100%; }
.cover-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, var(--primary-light), var(--primary));
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
}
.cp-line1 { font-size: 52rpx; font-weight: 700; text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.2); }
.cp-line2 { font-size: 26rpx; margin-top: 8rpx; opacity: 0.9; }

.course-tag {
  position: absolute;
  top: 20rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
}
.course-tag.expired { left: 20rpx; background: rgba(0,0,0,0.6); color: #fff; }
.course-tag.recurrence {
  top: 60rpx;                              /* 排在价格/已截止下面，避免互相压住 */
  left: 20rpx;
  background: rgba(14, 165, 233, 0.92);
  color: #fff;
  font-size: 22rpx;
}
.course-tag.price {
  right: 20rpx;
  background: var(--gold);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}
.course-tag.price .per { font-size: 20rpx; font-weight: 400; opacity: 0.9; }

.course-body { padding: 24rpx 28rpx 28rpx; }
.course-title { font-size: 32rpx; font-weight: 600; margin-bottom: 12rpx; }

/* 教练 / 课时 芯片行 */
.course-chips { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 12rpx; }
.chip {
  font-size: 22rpx;
  color: var(--primary);
  background: rgba(58, 125, 68, 0.10);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

.course-meta { display: flex; gap: 20rpx; font-size: 24rpx; margin-bottom: 8rpx; }
.meta-people { color: var(--primary); font-weight: 500; }
.meta-min { color: #b45309; }
.course-loc, .course-time { font-size: 24rpx; color: var(--muted); margin-top: 4rpx; }

.empty { text-align: center; color: var(--muted); padding: 80rpx 0; }
.btn-empty {
  margin: 28rpx auto 0;
  width: 340rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  color: #fff;
  background: var(--primary);
  border-radius: 999rpx;
}
.btn-empty::after { border: none; }
.btn-hover { opacity: 0.8; }
