/* 自定义 tabBar */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  height: 120rpx;
  background: rgba(58, 125, 68, 0.88);
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
  box-shadow: 0 -6rpx 24rpx rgba(0, 0, 0, 0.18);
  z-index: 9999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: env(safe-area-inset-bottom);
}
